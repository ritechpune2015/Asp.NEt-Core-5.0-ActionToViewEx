@model IEnumerable<ActionToViewEx.Models.Product>
<!DOCTYPE html>
    <html>
    <head>
        <title></title>
    </head>
    <body>
       <h2> Product Info</h2>
       <table border="1">
           <thead>
               <tr>
                   <th>Prdouct ID</th>
                   <th> Product Name </th>
                   <th> Mfg Name </th>
                   <th> Price</th>
               </tr>
           </thead>
           <tbody>
            @foreach (var temp in Model)
            {
                <tr>
                    <td>@temp.ProductID</td>
                    <td>@temp.ProductName</td>
                    <td>@temp.MfgName</td>
                    <td>@temp.Price</td>
                </tr>
            }
        </tbody>
       </table>
    </body>
    </html>